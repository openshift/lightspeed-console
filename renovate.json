{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["* 6 * * *"],
  "prHourlyLimit": 10,
  "timezone": "UTC",
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "14 days",
      "schedule": ["* * * * *"]
    },
    {
      "matchPackageNames": ["/^quay\\.io\\/konflux-ci\\//"],
      "minimumReleaseAge": "0 days",
      "addLabels": [
        "approved",
        "lgtm"
      ]
    },
    {
      "matchFileNames": ["rpms.in.yaml", "rpms.lock.yaml"],
      "addLabels": [
        "approved",
        "lgtm"
      ]
    },
    {
      "matchPackageNames": ["react", "react-dom", "react-i18next", "react-redux", "react-router"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@types/node",
        "@types/react",
        "@patternfly/*",
        "eslint",
        "react-markdown",
        "remark-gfm"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["node"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@openshift-console/dynamic-plugin-sdk", "@openshift-console/dynamic-plugin-sdk-webpack"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "groupName": "lint",
      "matchPackageNames": [
        "@typescript-eslint/*",
        "eslint",
        "eslint-*",
        "prettier",
        "stylelint",
        "stylelint-*"
      ],
      "schedule": ["* 6 1,15 * *"]
    },
    {
      "groupName": "patternfly",
      "matchPackageNames": ["@patternfly/*"]
    },
    {
      "groupName": "test",
      "matchPackageNames": ["@playwright/*", "mcr.microsoft.com/playwright"],
      "minimumReleaseAge": "14 days",
      "schedule": ["* 6 1,15 * *"]
    }
  ]
}
