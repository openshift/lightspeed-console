{
  "name": "lightspeed-console-plugin",
  "version": "2.0.1",
  "description": "OpenShift Lightspeed console plugin",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=11.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openshift/lightspeed-console.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production npm run ts-node node_modules/.bin/webpack",
    "build-dev": "npm run clean && npm run ts-node node_modules/.bin/webpack",
    "start": "npm run ts-node node_modules/.bin/webpack serve",
    "start-console": "./start-console.sh",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "ts-node": "ts-node -O '{\"module\":\"commonjs\"}'",
    "lint": "eslint ./*.{js,mts,ts} ./src ./tests ./unit-tests && stylelint \"src/**/*.css\" --allow-empty-input && tsc -p unit-tests",
    "lint-fix": "eslint ./*.{js,mts,ts} ./src ./tests ./unit-tests --fix && stylelint \"src/**/*.css\" --allow-empty-input --fix && tsc -p unit-tests",
    "test": "npx playwright test --ui",
    "test-headless": "npx playwright test",
    "test-unit": "vitest run",
    "test-watch": "vitest"
  },
  "dependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@patternfly/chatbot": "6.6.0",
    "@patternfly/react-code-editor": "6.6.0",
    "@patternfly/react-core": "6.6.0",
    "@patternfly/react-icons": "6.6.0",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "4.17.27",
    "@types/murmurhash-js": "1.0.7",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "marked": "18.1.2",
    "murmurhash-js": "1.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "16.5.8",
    "react-redux": "9.2.0",
    "react-router": "7.13.2",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next-parser": "9.4.0",
    "pluralize": "8.0.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "vitest": "5.0.5",
    "webpack-dev-server": "6.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "monaco-editor": "0.57.0"
  },
  "consolePlugin": {
    "name": "lightspeed-console-plugin",
    "version": "2.0.1",
    "displayName": "OpenShift Lightspeed Console Plugin",
    "description": "Add UI elements for interacting with OpenShift Lightspeed to the OpenShift web console.",
    "exposedModules": {
      "OLSFlags": "./flags",
      "NullContextProvider": "./components/NullContextProvider",
      "OLSReducer": "./redux-reducers",
      "OverviewDetail": "./components/OverviewDetail",
      "useOpenOLS": "./hooks/useOpenOLS",
      "usePopover": "./hooks/usePopover"
    },
    "dependencies": {
      "@console/pluginAPI": ">=4.22.0-0"
    }
  }
}
